{
  "name": "ux-heatgrid",
  "version": "2.0.0",
  "private": true,
  "description": "HeatGrid — Predict and Record page interactions in a Chrome side panel",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
