{
  "name": "ux-heatgrid",
  "version": "2.0.0-dev",
  "private": true,
  "description": "UX HeatGrid V2 — interaction-first design inspection extension",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
